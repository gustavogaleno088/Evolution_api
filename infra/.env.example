# Copie para .env:  cp .env.example .env
# Gere a chave com:  openssl rand -hex 32

# ---------- Servidor ----------
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=http://SEU_IP_PUBLICO:8080

# ---------- Autenticação (sua "API Key" global) ----------
AUTHENTICATION_API_KEY=TROQUE_POR_UMA_CHAVE_FORTE
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

# ---------- Banco de dados (Postgres do docker-compose) ----------
POSTGRES_USER=evolution
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA
POSTGRES_DB=evolution
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:TROQUE_ESTA_SENHA@postgres:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=evolution_exchange
DATABASE_SAVE_DATA_INSTANCE=true
# Privacidade: não guardar conversas, contatos nem histórico do celular conectado.
# A Evolution não precisa disso para enviar mensagens.
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false

# ---------- Cache (Redis do docker-compose) ----------
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# ---------- QR Code ----------
QRCODE_LIMIT=30
QRCODE_COLOR=#175197

# ---------- Webhook global (opcional; preferimos webhook por instância) ----------
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_GLOBAL_URL=
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false

# ---------- Diversos ----------
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true
LOG_LEVEL=ERROR,WARN,INFO
LOG_BAILEYS=error
DEL_INSTANCE=false
LANGUAGE=pt-BR
CONFIG_SESSION_PHONE_CLIENT=Evolution API
CONFIG_SESSION_PHONE_NAME=Chrome
