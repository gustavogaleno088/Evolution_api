PORT=3000
# Se o backend roda na mesma VPS da Evolution, use http://localhost:8080
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=MESMA_CHAVE_DO_AUTHENTICATION_API_KEY
EVOLUTION_INSTANCE=meu-whatsapp
# Token simples para proteger sua própria API (header x-api-token)
BACKEND_TOKEN=TROQUE_POR_UM_TOKEN
# Segredo opcional no webhook: configure a URL como .../webhook/evolution?secret=XYZ
WEBHOOK_SECRET=
